# Copy this file to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Use a local MongoDB database or replace with an approved development connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/civictrack?replicaSet=civictrack-rs

# Replace with a long, random development-only secret.
JWT_SECRET=replace-with-a-long-random-development-secret

# Cookie and upload policy
COOKIE_NAME=civictrack_session
CLIENT_ORIGIN=http://localhost:3000
UPLOAD_DIR=server/uploads
MAX_UPLOAD_SIZE_BYTES=5242880
